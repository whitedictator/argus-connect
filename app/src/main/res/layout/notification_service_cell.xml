<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/service_cell" android:importantForAccessibility="yes" android:orientation="horizontal"
    android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
    android:gravity="center_vertical" android:paddingEnd="4dp">
    <ImageView android:id="@+id/service_icon" android:layout_width="22dp" android:layout_height="22dp"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/service_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="5dp" android:textSize="11sp" android:singleLine="true"
        style="@android:style/TextAppearance.Material.Notification" />
    <ImageView android:id="@+id/service_mark" android:layout_width="9dp" android:layout_height="9dp"
        android:layout_marginStart="6dp" android:importantForAccessibility="no" />
</LinearLayout>
