<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/notification_services" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="44dp" />
    <LinearLayout android:id="@+id/notification_social" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="44dp" />
    <TextView android:id="@+id/notification_details" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp" android:paddingTop="6dp"
        android:maxLines="6" style="@android:style/TextAppearance.Material.Notification" />
</LinearLayout>
